      LAYER met1 ;
        RECT 0.070 10.640 46.390 49.200 ;
      LAYER met2 ;
        RECT 0.100 58.160 12.690 58.440 ;
        RECT 13.530 58.160 46.370 58.440 ;
        RECT 0.100 4.280 46.370 58.160 ;
        RECT 0.650 4.000 46.370 4.280 ;
      LAYER met3 ;
