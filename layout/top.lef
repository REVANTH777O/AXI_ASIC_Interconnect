    END
    PORT
      LAYER met5 ;
        RECT 5.280 27.660 46.240 29.260 ;
    END
    PORT
      LAYER met5 ;
        RECT 5.280 37.180 46.240 38.780 ;
    END
    PORT
      LAYER met5 ;
        RECT 5.280 46.700 46.240 48.300 ;
    END
  END VGND
  PIN VPWR
    DIRECTION INOUT ;
    USE POWER ;
    PORT
      LAYER met4 ;
        RECT 9.780 10.640 11.380 49.200 ;
    END
    PORT
      LAYER met4 ;
        RECT 19.900 10.640 21.500 49.200 ;
